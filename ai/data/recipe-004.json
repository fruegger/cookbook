  "methods": [
    {
      "name": {
        "de": "Toastbrot",
        "en": "",
        "fr": "",
        "it": ""
      },
      "steps": [
        {
          "id": "t1",
          "time": null,
          "tools": [
            "kleine Pfanne",
            "Schwingbesen"
          ],
          "text": {
            "de": "Zuerst Tangzhong machen: 10 g Mehl, 30 g Milch und 15 g Wasser in einer kleinen Pfanne — auf mittlerer Hitze unter ständigem Rühren mit dem Schwingbesen aufkochen, bis ein Gel entsteht. Eine Weile passiert nichts, dann ziemlich plötzlich doch.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "Nicht aufhören zu rühren, sonst klumpt es.",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t2",
          "time": "7–8 min",
          "tools": [
            "Schüssel"
          ],
          "text": {
            "de": "Die restlichen 70 g Milch lauwarm machen, mit dem Zucker und der Trockenhefe verrühren. 7–8 Minuten warten, bis die Hefe aktiviert ist (am Schaum erkennbar).",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "Wirklich nur lauwarm — heisse Milch tötet die Hefe.",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t3",
          "time": null,
          "tools": [],
          "text": {
            "de": "Die Milch-Hefe-Zucker-Mischung mit dem Tangzhong-Gel verrühren.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t4",
          "time": "≈ 10 min",
          "tools": [
            "Schüssel"
          ],
          "text": {
            "de": "In einer anderen Schüssel Mehl und Salz vermischen. Die Gel-Flüssigkeit dazugeben und etwa 10 Minuten zu einem geschmeidigen Teig kneten.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t5",
          "time": null,
          "tools": [],
          "text": {
            "de": "Stückchenweise die Butter in den Teig einarbeiten — ähnlich wie beim Brioche-Teig.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t6",
          "time": "1–2 h",
          "tools": [
            "Tuch"
          ],
          "text": {
            "de": "Wenn der Teig geschmeidig und elastisch ist, abgedeckt 1–2 Stunden ruhen lassen (oder bis sich das Volumen verdoppelt hat).",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t7",
          "time": null,
          "tools": [
            "Wallholz"
          ],
          "text": {
            "de": "Vier gleich grosse Würste formen. Ich mache zuerst Bällchen, walle sie flach und rolle sie dann zu Würstchen auf.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t8",
          "time": "1–2 h",
          "tools": [
            "kleine Form",
            "Tuch"
          ],
          "text": {
            "de": "Die Teigröllchen in eine kleine, gebutterte Form legen — sie müssen sich berühren, kein Raum dazwischen — und nochmals abgedeckt 1–2 Stunden ruhen lassen.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t9",
          "time": null,
          "tools": [
            "Pinsel"
          ],
          "text": {
            "de": "Inzwischen sollten die Röllchen zu einem Brot zusammengewachsen sein. Mit Eiguss bestreichen (ich mag etwas Sahne lieber).",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t10",
          "time": "16–20 min",
          "tools": [
            "Ofen, 190 °C"
          ],
          "text": {
            "de": "Bei 190 °C 16–20 Minuten goldbraun backen.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "t11",
          "time": null,
          "tools": [],
          "text": {
            "de": "Ob du das Brot in Scheiben schneidest und toastest oder so aufträgst, ist Geschmacksache.",
            "en": "",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        }
      ]
    }
