  "methods": [
    {
      "name": {
        "de": "",
        "en": "Stuffed zucchini",
        "fr": "",
        "it": ""
      },
      "steps": [
        {
          "id": "z1",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "Cut the zucchini in half lengthwise (and in bite sized shells like the ones in the picture, if you are brave). Salt the insides lightly.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z2",
          "time": null,
          "tools": {
            "de": [],
            "en": [
              "spoon"
            ],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "Scoop out the flesh of the zucchini with a tea spoon. Do not discard the flesh, you'll need it in a minute",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "To obtain nice shells you will have to score the edges with a knife before scooping the flesh out.",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z3",
          "time": "10'",
          "tools": {
            "de": [],
            "en": [
              "knife or blender",
              "small bowl"
            ],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "cut the flesh of the zucchini to a tartare (or blitz it in a blender), place it in a small bowl with a pinch of salt; let it sit for 10 minutes.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z4",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "pass the zucchini flesh through a sieve (or press the water out of it with your hands or a paper towel). ",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "How the water is shed does not really matter: the idea is to prevent the stuffing from becoming soggy.",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z5",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "Blitz the bread and amaretti for a few seconds to soft bread crumbs.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "you can also just cut the bread in small cubes, if you like a more rustic stuffing.",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z6",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "mix the bread and amaretti crumbs, the zucchini flesh, the parmesan and the egg in a bowl.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z7",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "hack the garlic and herbs, add them in to the mixture, season with salt and pepper. Preserve some of the herbs for the garnishing oil.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z8",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "Spoon the mixture back into the zucchini shells (or pipe it in with a patisserie bag if it is smooth enough)  and place them on a baking sheet.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z9",
          "time": "15'",
          "tools": {
            "de": [],
            "en": [
              "oven - 210°C"
            ],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "Bake in the oven at 210 degrees for about 15 minutes.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "z10",
          "time": null,
          "tools": {
            "de": [],
            "en": [],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "",
            "en": "Optionally grate some lemon zest, add it to the preserved herbs, add some olive oil and sprinkle over the zucchini just before dinner time.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        }
      ]
    },
    {
      "name": {
        "de": "Bratkartoffeln",
        "en": "Roast potatoes",
        "fr": "",
        "it": ""
      },
      "steps": [
        {
          "id": "bk1",
          "time": null,
          "tools": {
            "de": [
              "Sparschäler",
              "Messer"
            ],
            "en": [
              "potato peeler",
              "knife"
            ],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "Schäle die Kartoffeln und schneide sie in Würfel.",
            "en": "Peel the potatoes and cut them into wedges.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "bk2",
          "time": "10 min",
          "tools": {
            "de": [
              "Topf",
              "Sieb"
            ],
            "en": [
              "pan",
              "sieve"
            ],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "Koche die Kartoffel 10 Minuten in Salzwasser, dann giesse sie ab. Lasse sie ein paar Minuten stehen, damit sie abtropfen und etwas trocknen.",
            "en": "Cook the potatoes in salty water for 10 minutes, then turn them over and let them cool down a bit. Let them rest for a few minutes to allow them to dry out.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "Das Trocknen ist wichtig — sonst spriztz die heisse Fett umher, wenn du die Kartoffen in die Pfanne gibst. Bei Butter ist das weniger problemnatisch als bei Öl, aber trotzdem wichtig.",
            "en": "Letting the potatoes dry is important - otherwise, the hot oil may spatter around when you put the potatoes in the pan.",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "bk3",
          "time": "5–10 min",
          "tools": {
            "de": [
              "Bratpfanne"
            ],
            "en": [
              "frying pan"
            ],
            "fr": [],
            "it": []
          },
          "text": {
            "de": "Erhitze die Butter (oder Ghee) in einer Bratpfanne und brate die Kartoffelwürfel bei mittlerer Hitze goldbraun an.",
            "en": "Heat the butter (or ghee) in a frying pan and fry the potatoes over medium heat until golden brown.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        },
        {
          "id": "bk4",
          "time": "1 min",
          "tools": [],
          "text": {
            "de": "Zum Schluss streust du Za'atar, Salz und Pfeffer nach belieben darüber und bratest eine Minute weiter.",
            "en": "Finally, sprinkle za'atar, salt, and pepper to taste over it and fry for another minute.",
            "fr": "",
            "it": ""
          },
          "photo": "",
          "warning": {
            "de": "",
            "en": "",
            "fr": "",
            "it": ""
          }
        }
      ]
    }
